# ============================================================
# ChurnIQ configuration — copy this file to ".env" and fill in
# the keys you want. Everything is OPTIONAL: the app runs fine
# with none of these (outbox email mode).
# Lines starting with # are comments.
# After changing this file, RESTART the backend.
# ============================================================

# ─── MongoDB ─────────────────────────────────────────────────
# MongoDB stores retention-strategy state shared by backend instances.
# CHURNIQ_MONGO_URI=mongodb://127.0.0.1:27017
# CHURNIQ_MONGO_DB=churniq

# ─── Retention emails (SMTP) ─────────────────────────────────
# Gmail example: enable 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords and paste it below.
# CHURNIQ_SMTP_HOST=smtp.gmail.com
# CHURNIQ_SMTP_PORT=587
# CHURNIQ_SMTP_USER=you@gmail.com
# CHURNIQ_SMTP_PASS=abcd efgh ijkl mnop
# CHURNIQ_SMTP_FROM=you@gmail.com

# ─── WhatsApp ────────────────────────────────────────────────
# No key needed. The app builds a wa.me deep link with the message
# pre-filled; opening it composes the WhatsApp message.

# ─── Misc (already have defaults) ────────────────────────────
# CHURNIQ_MAX_UPLOAD_BYTES=26214400
# CHURNIQ_MAX_TRAINING_WORKERS=1
# CHURNIQ_MODEL_MIN_AUC=0.50
# CHURNIQ_ADMIN_API_KEY=
